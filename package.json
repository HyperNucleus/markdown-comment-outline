{
  "name": "markdown-comment-outline",
  "displayName": "Markdown Comment Outline",
  "description": "Navigate code using Markdown headings in comments: // ## Section, # ## Section, /* ## Section */ and more.",
  "version": "0.1.0",
  "publisher": "HyperNucleus",
  "author": {
    "name": "HyperNucleus",
    "url": "https://github.com/HyperNucleus"
  },
  "license": "MIT",
  "icon": "icon_v2.png",
  "preview": false,
  "engines": {
    "vscode": "^1.137.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "outline",
    "markdown",
    "comments",
    "navigation",
    "sections",
    "breadcrumbs",
    "symbols"
  ],
  "activationEvents": [
    "*",
    "onStartupFinished"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/HyperNucleus/markdown-comment-outline.git"
  },
  "bugs": {
    "url": "https://github.com/HyperNucleus/markdown-comment-outline/issues"
  },
  "homepage": "https://github.com/HyperNucleus/markdown-comment-outline#readme",
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown Comment Outline",
      "properties": {
        "markdownCommentOutline.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Markdown Comment Outline extension"
        },
        "markdownCommentOutline.supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*"
          ],
          "description": "List of languages to support. Use '*' for all languages, or specify individual languages like 'python', 'javascript', etc."
        },
        "markdownCommentOutline.maxNestingLevel": {
          "type": "integer",
          "default": 6,
          "minimum": 1,
          "maximum": 6,
          "description": "Maximum nesting level for sections (1-6)"
        },
        "markdownCommentOutline.showIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show the depth icon before each section name in the Markdown Comment Outline view. Turn off for a text-only outline. This does not affect the built-in Outline view or breadcrumbs, whose icons VS Code draws itself \u2014 use the built-in 'outline.icons' and 'breadcrumbs.icons' settings for those."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownCommentOutline",
          "title": "Markdown Comment Outline",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "markdownCommentOutline": [
        {
          "id": "markdownCommentOutlineOutlineActivity",
          "name": "Markdown Comment Outline",
          "when": "resourceLangId"
        }
      ]
    },
    "commands": [
      {
        "command": "markdownCommentOutline.activate",
        "title": "Activate",
        "category": "Markdown Comment Outline"
      },
      {
        "command": "markdownCommentOutline.showView",
        "title": "Show Markdown Comment Outline",
        "category": "Markdown Comment Outline"
      }
    ],
    "colors": [
      {
        "id": "markdownCommentOutline.currentSectionBackground",
        "description": "Background of the line holding the section your cursor is in. Must not be opaque \u2014 VS Code paints extension decorations on top of the text selection, so a solid color here hides selections made on that line.",
        "defaults": {
          "dark": "#ffffff0f",
          "light": "#0000000a",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "test": "vscode-test",
    "package:vsix": "vsce package --no-dependencies",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/**/*.test.js\" --ignore \"out/test/{sectionIndex,documentSymbolProvider,treeDataProvider,decorations,extension,cursorSync}.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.3",
    "@types/vscode": "1.137.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "npm-run-all": "4.1.5",
    "ovsx": "1.2.0",
    "typescript": "7.0.2",
    "mocha": "12.0.1",
    "oxlint": "1.83.0"
  }
}
